{
  "name": "@agent-factory/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "test:e2e:contract": "node --test ../../tests/e2e/operator-console-contract.test.mjs",
    "verify:smoke": "node ../../tests/e2e/operator-console-smoke.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@agent-factory/contracts": "workspace:*",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "vite": "7.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "@playwright/test": "1.56.1"
  }
}
