# Machine 2 worker configuration. The worker reuses the shared .env in Docker.
WORKER_TOKEN=replace-with-a-different-32-character-token
API_BASE_URL=http://127.0.0.1:3000
ORGANIZATION_ID=org-demo
WORKER_PRINCIPAL_ID=worker-local
ARTIFACT_ROOT=./artifacts
SOURCE_ROOT=./sources
MODEL_NAME=gpt-5-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
WORKER_LEASE_SECONDS=120
WORKER_POLL_MS=2000
WORKER_REQUEST_TIMEOUT_MS=120000
WORKER_ESTIMATED_COST_PER_CALL=0.05
WORKER_MAX_TOOL_ROUNDS=8
